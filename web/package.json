{
  "name": "neopact-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write app components lib tests scripts *.ts *.json",
    "format:check": "prettier --check app components lib tests scripts *.ts *.json",
    "test:unit": "playwright test api-client.spec.ts proxy.spec.ts connections.spec.ts",
    "test:ui": "playwright test --config playwright.guidance.config.ts",
    "api:generate": "bash scripts/generate-api-types.sh",
    "api:check": "bash scripts/generate-api-types.sh --check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
